# ==============================================================================
# FMCG+ Retail POS & Customer Khata - Backend Environment Configuration Template
# ==============================================================================

PORT=8080
GIN_MODE=debug # options: debug, release, test

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fmcg_pos
DB_SSLMODE=disable
# Optional full URI override:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/fmcg_pos?sslmode=disable

# AWS S3 Storage
AWS_S3_BUCKET=fmcg-plus-retail-assets
AWS_REGION=ap-southeast-1
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local Uploads Directory
UPLOADS_DIR=uploads

# FMCG Dataset Path
DATA_FILE_PATH=../bangladesh_fmcg_products.json

# Auth & Security
JWT_SECRET=fmcg-plus-super-secret-jwt-key
OTP_PROVIDER=nishchit # options: nishchit, firebase, local, mock
FIREBASE_PROJECT_ID=fmcg-plus

# Nishchit SMS Gateway (https://nishchit.tech)
# Test keys begin with 'nk_test_' (zero carrier reach, zero credit spend)
# Live keys begin with 'nk_live_'
NISHCHIT_API_KEY=nk_test_your_api_key_here
NISHCHIT_BASE_URL=https://api.nishchit.tech
# Leave blank to use project's default shared sender (recommended)
NISHCHIT_FROM=

